{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "noEmit": true,
    "types": ["node"],
    // Node runs these files directly (type stripping), so only erasable syntax is allowed.
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true
  },
  "include": ["*.ts"]
}
