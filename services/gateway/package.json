{
  "name": "@lfc/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Only public API entry point: REST + WebSocket, sessions, audio forwarding, event push (brief 5).",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch --conditions=development src/main.ts",
    "start": "node dist/main.js",
    "test:unit": "vitest run --project unit",
    "test:int": "vitest run --project int",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/rate-limit": "11.2.0",
    "@fastify/websocket": "11.3.1",
    "@lfc/contracts": "workspace:*",
    "@lfc/service-kit": "workspace:*",
    "ioredis": "6.0.0",
    "ws": "8.21.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@testcontainers/redis": "12.1.0",
    "@types/node": "24.13.6",
    "@types/ws": "8.18.1",
    "@vitest/coverage-v8": "5.0.1",
    "prom-client": "15.1.3",
    "testcontainers": "12.1.0",
    "tsx": "4.23.14",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
