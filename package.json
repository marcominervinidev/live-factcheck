{
  "name": "live-factcheck",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.21.0 <25"
  },
  "scripts": {
    "typecheck": "tsc -b --pretty",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "depcruise": "depcruise --config .dependency-cruiser.cjs .",
    "test:unit": "pnpm -r --if-present test:unit",
    "test:int": "pnpm -r --if-present test:int"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.8.1",
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "dependency-cruiser": "18.4.0",
    "eslint": "10.0.1",
    "globals": "17.12.0",
    "lefthook": "2.1.14",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
