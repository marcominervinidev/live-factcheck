# Non-secret configuration for `docker compose` / `make up`. Copy to `.env` and adjust.
# Secrets never go here: they live one file per secret in SECRETS_DIR (make secrets-init).

# --- Secrets directory (outside the repository) --------------------------------------------
SECRETS_DIR=${HOME}/.config/live-factcheck/secrets

# --- Edge / HTTPS ----------------------------------------------------------------------------
# Name under which the iPhone reaches the Mac in the LAN (Caddy issues a certificate for it).
LAN_HOST=lfc.local
# Host ports of Caddy. macOS may already run Apache on 80; the HTTP port only redirects.
LFC_HTTP_PORT=80
LFC_HTTPS_PORT=443

# --- Logging ---------------------------------------------------------------------------------
LOG_LEVEL=info

# --- Privacy (brief 15.6) ---------------------------------------------------------------------
# cloud: cloud providers allowed. local: every worker refuses to start if a configured provider
# would send data outside your network (Anthropic, TypeSafe/Jev, Google Fact Check, cloud LLMs).
PRIVACY_MODE=cloud

# --- LLM per task (brief 8) -------------------------------------------------------------------
# Providers: mock | anthropic | openai-compatible. Model names are only ever configured here.
# The API key is the secret file anthropic_api_key (only needed for provider "anthropic").
#
# Claude: a fast, cheap model for extraction and explanations, a stronger one for the verdict:
#   EXTRACTOR_LLM_PROVIDER=anthropic   EXTRACTOR_LLM_MODEL=claude-haiku-4-5
#   CHECKER_LLM_PROVIDER=anthropic     CHECKER_LLM_MODEL=claude-opus-5
#   EXPLAINER_LLM_PROVIDER=anthropic   EXPLAINER_LLM_MODEL=claude-haiku-4-5
#
# Local models run natively on the Mac (Docker on macOS has no GPU access) and are reached from
# containers via host.docker.internal (fact-checker and explainer are on the egress network).
#   LM Studio: CHECKER_LLM_PROVIDER=openai-compatible  CHECKER_LLM_BASE_URL=http://host.docker.internal:1234/v1
#   Ollama:    CHECKER_LLM_PROVIDER=openai-compatible  CHECKER_LLM_BASE_URL=http://host.docker.internal:11434/v1
# Bind LM Studio and Ollama to localhost only, never to the LAN (brief 15.4).
# Local models are slower: raise the time per model call and per whole check/explanation, e.g.
#   CHECKER_LLM_TIMEOUT_MS=120000  CHECKER_TIMEOUT_MS=300000
#   EXPLAINER_LLM_TIMEOUT_MS=120000  EXPLAINER_TIMEOUT_MS=180000
# (defaults: 30 s per call, 60 s per check, 45 s per explanation). A 7B model on a 16 GB Mac
# only keeps up if the machine does not swap: stop other stacks and memory-hungry apps.
EXTRACTOR_LLM_PROVIDER=mock
EXTRACTOR_LLM_MODEL=mock
EXTRACTOR_LLM_BASE_URL=
CHECKER_LLM_PROVIDER=mock
CHECKER_LLM_MODEL=mock
CHECKER_LLM_BASE_URL=
EXPLAINER_LLM_PROVIDER=mock
EXPLAINER_LLM_MODEL=mock
EXPLAINER_LLM_BASE_URL=

# --- Classifier per task (brief 8.1, ADR 0007) -------------------------------------------------
# Providers: mock | llm | typesafe. "llm" uses the task's CHECKER_LLM_* settings.
# typesafe (Jev, early access): pin a version, never the moving alias, because the thresholds
# are tuned per version. The key is the secret file typesafe_api_key.
#   CHECKER_CLASSIFIER_PROVIDER=typesafe   CHECKER_CLASSIFIER_MODEL=jev-1.13.0
# Confidence >= HIGH: act; >= LOW: shown as "unsicher"; below LOW: no verdict (nicht_pruefbar).
CHECKER_CLASSIFIER_PROVIDER=mock
CHECKER_CLASSIFIER_MODEL=
CHECKER_CONFIDENCE_HIGH=0.75
CHECKER_CONFIDENCE_LOW=0.45

# --- Claim detection in the live transcript (ADR 0017) ---------------------------------------
# Classifier for "is this a checkable claim?": mock | llm (uses EXTRACTOR_LLM_*) | typesafe (Jev).
# Precision first: a "yes" below DETECTOR_CONFIDENCE_HIGH is dropped, not shown.
DETECTOR_CLASSIFIER_PROVIDER=mock
DETECTOR_CONFIDENCE_HIGH=0.75
DETECTOR_CONFIDENCE_LOW=0.5
# Minimum checkworthiness on the 1–5 scale (default 3); segments of context per session (default 6).
DETECTOR_MIN_SCORE=
DETECTOR_WINDOW_SEGMENTS=

# --- Research (brief 9) ----------------------------------------------------------------------
# live: Wikipedia, Wikidata and web search (bundled SearXNG) on the internet, plus Google Fact
# Check when the secret file google_factcheck_api_key is filled. mock: a small fixed corpus
# (tests, CI, trying the app without internet).
CHECKER_RESEARCH_SOURCES=mock
SEARCH_PROVIDER=searxng
# Embeddings rank the research snippets. mock: hashed bag of words (no model needed).
# A local model via LM Studio/Ollama: EMBEDDINGS_PROVIDER=openai-compatible,
#   EMBEDDINGS_BASE_URL=http://host.docker.internal:1234/v1, EMBEDDINGS_MODEL=<model name>
EMBEDDINGS_PROVIDER=mock
EMBEDDINGS_MODEL=mock
EMBEDDINGS_BASE_URL=

# --- Speech-to-text (brief 10, ADR 0016) ------------------------------------------------------
# mock | deepgram | assemblyai | local. Deepgram and AssemblyAI read their key from the secret
# files deepgram_api_key / assemblyai_api_key (never here) and use the EU endpoints by default.
#   STT_PROVIDER=deepgram     STT_MODEL=nova-3
#   STT_PROVIDER=assemblyai   STT_MODEL=universal-streaming-multilingual
#   STT_PROVIDER=local        STT_MODEL=small   LOCAL_STT_URL=ws://stt-local:8000/v1/stream
#     (native on the Mac: LOCAL_STT_URL=ws://host.docker.internal:8000/v1/stream)
# PRIVACY_MODE=local refuses deepgram and assemblyai at startup.
STT_PROVIDER=mock
STT_MODEL=mock
STT_LANGUAGE=de
STT_REGION=eu
LOCAL_STT_URL=
# Silence (ms) after which the cloud provider closes an utterance; default 300.
STT_ENDPOINTING_MS=

# --- Budget (brief 15.5) ---------------------------------------------------------------------
# Daily cap per worker for cloud models in USD; when used up, claims end as nicht_pruefbar.
CLOUD_DAILY_BUDGET_USD=2
