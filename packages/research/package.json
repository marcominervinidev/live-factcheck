{
  "name": "@lfc/research",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Evidence research shared by fact-checker and topic-tracker: safe fetching, source tiers, text extraction, chunking, ranking and caches (brief 9).",
  "exports": {
    ".": {
      "development": "./src/index.ts",
