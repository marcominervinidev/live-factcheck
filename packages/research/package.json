  "dependencies": {
    "@lfc/contracts": "workspace:*",
    "@lfc/providers": "workspace:*",
    "@mozilla/readability": "0.6.0",
    "jsdom": "30.1.1",
    "undici": "8.11.2",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  }
}
