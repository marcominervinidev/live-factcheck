{
  "name": "@lfc/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Mobile-first PWA frontend, served by nginx (brief 5, 11).",
  "scripts": {
    "build": "vite build",
    "dev": "vite --host 0.0.0.0 --port 5173",
    "lighthouse": "lhci autorun --config=lighthouserc.json",
    "preview": "vite preview --host 0.0.0.0 --port 4173",
    "test:int": "playwright test -c tests/playwright.config.ts",
    "test:mutation": "stryker run",
    "test:unit": "vitest run --project unit",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@lfc/contracts": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.63.0",
    "@stryker-mutator/core": "10.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "5.0.1",
    "jsdom": "30.1.1",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.1",
    "vitest": "5.0.1"
  }
}
